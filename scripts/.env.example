# Copy this file to scripts/.env (gitignored) and fill in machine-local paths.
# Values here are only defaults for -OutputDirectory; every script also accepts
# an explicit -OutputDirectory argument that overrides both the env var and this file.

# Where build-android.ps1 copies the finished APK.
SAFETY_ANDROID_OUTPUT_DIR=D:\Builds\SafetyTraining\Android

# Where build-authoring.ps1 copies the published Authoring GUI, in addition to
# the default publish location at dist/AuthoringApp. Leave unset to skip the copy.
SAFETY_AUTHORING_OUTPUT_DIR=D:\Builds\SafetyTraining\AuthoringApp
