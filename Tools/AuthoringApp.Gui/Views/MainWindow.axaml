<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SafetyProto.AuthoringApp.Gui.ViewModels"
        x:Class="SafetyProto.AuthoringApp.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1080" Height="760"
        MinWidth="820" MinHeight="520"
        Title="SafetyProto — Autoria de Cenários">

  <DockPanel Margin="8">

    <!-- Toolbar. The theme toggle is docked right so it stays clear of the action buttons. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" x:Name="ThemeButton" Click="OnToggleTheme"
              ToolTip.Tip="Alternar entre o tema claro e o escuro"/>

      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Novo" Click="OnNew"/>
        <Button Content="Abrir…" Click="OnOpenScenario"/>
        <Button Content="Catálogo…" Click="OnOpenCatalog"/>
        <Button Content="Ações…" Click="OnOpenActionCatalog"/>
        <Border Width="1" Background="{DynamicResource SpBorder}" Margin="4,2"/>
        <Button Content="Validar" Click="OnValidate" IsEnabled="{Binding HasScenario}"/>
        <Button Content="Salvar…" Click="OnSave" IsEnabled="{Binding HasScenario}"/>
        <Button Content="Deploy (adb)" Click="OnDeploy" IsEnabled="{Binding HasScenario}"/>
      </StackPanel>
    </DockPanel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="panel"
            Margin="0,8,0,0" Padding="8" MaxHeight="180">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,4">
          <TextBlock Text="{Binding ScenarioPath, StringFormat='Cenário: {0}'}"
                     FontSize="11" Foreground="{DynamicResource SpTextDim}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding CatalogPath, StringFormat='Catálogo: {0}'}"
                     FontSize="11" Foreground="{DynamicResource SpTextDim}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding ActionCatalogPath, StringFormat='Ações: {0}'}"
                     FontSize="11" Foreground="{DynamicResource SpTextDim}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBox Text="{Binding Status}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Cascadia Mono, Consolas, monospace" Background="Transparent"
                 BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </DockPanel>
    </Border>

    <TabControl SelectionChanged="OnTabChanged">
      <TabItem Header="Cenário">
    <Grid ColumnDefinitions="2*,Auto,3*">

      <!-- Master: scenario header + tree -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasScenario}"
                   Text="Nenhum cenário aberto.&#x0a;Use Novo ou Abrir…"
                   Foreground="{DynamicResource SpTextDim}" Margin="4,12"/>

        <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasScenario}" Spacing="6" Margin="0,0,8,8">
          <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome:" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Editor.Name}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Participante:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Editor.ParticipantId}"/>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="+ Grupo" Click="OnAddGroup"/>
            <Button Content="+ Tarefa" Click="OnAddTask"/>
            <Button Content="Remover" Click="OnRemove"/>
          </StackPanel>
        </StackPanel>

        <Border Classes="panel" Margin="0,0,8,0"
                IsVisible="{Binding HasScenario}">
          <TreeView ItemsSource="{Binding Editor.Groups}"
                    SelectedItem="{Binding Editor.SelectedNode, Mode=TwoWay}">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="vm:GroupViewModel" ItemsSource="{Binding Tasks}">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
              </TreeDataTemplate>
              <DataTemplate DataType="vm:TaskViewModel">
                <TextBlock Text="{Binding DisplayName}"/>
              </DataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"/>

      <!-- Detail: editor for the selected node -->
      <ScrollViewer Grid.Column="2" Margin="8,0,0,0">
        <ContentControl Content="{Binding Editor.SelectedNode}">
          <ContentControl.DataTemplates>

            <!-- Group editor -->
            <DataTemplate DataType="vm:GroupViewModel">
              <StackPanel Spacing="8">
                <TextBlock Text="Grupo" Classes="heading"/>
                <StackPanel Spacing="2">
                  <TextBlock Text="Id (opcional — usa o nome se vazio)" Classes="label"/>
                  <TextBox Text="{Binding GroupId}" Watermark="ex.: ppe_selection"/>
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Nome" Classes="label"/>
                  <TextBox Text="{Binding GroupName}"/>
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Objetivo geral (modo Avaliação)" Classes="label"/>
                  <TextBox Text="{Binding Objective}" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Modo de execução" Classes="label"/>
                  <ComboBox ItemsSource="{Binding ExecutionModes}" SelectedItem="{Binding ExecutionMode}"
                            HorizontalAlignment="Left" MinWidth="200"/>
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Tempo limite (s)" Classes="label"/>
                  <TextBox Text="{Binding TimeLimit}" HorizontalAlignment="Left" MinWidth="120"/>
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Grupos requeridos (separados por vírgula)" Classes="label"/>
                  <TextBox Text="{Binding RequiredGroupsCsv}" Watermark="ex.: Seleção de EPIs"/>
                </StackPanel>
              </StackPanel>
            </DataTemplate>

            <!-- Task editor. Each card is one concern, so an author scanning for "the decoys" or
                 "the report popup" finds a title instead of reading every caption. -->
            <DataTemplate DataType="vm:TaskViewModel">
              <StackPanel Spacing="10">
                <TextBlock Text="Tarefa" Classes="heading"/>

                <Border Classes="panel" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Identificação" Classes="section"/>
                    <Grid ColumnDefinitions="*,8,2*">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Id (opcional)" Classes="label"/>
                        <TextBox Text="{Binding TaskId}" Watermark="ex.: equip_helmet"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Nome" Classes="label"/>
                        <TextBox Text="{Binding TaskName}"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Descrição" Classes="label"/>
                      <TextBox Text="{Binding TaskDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Ação" Classes="label"/>
                      <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction}"
                                HorizontalAlignment="Left" MinWidth="260"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="EPIs requeridos" Classes="label"/>
                      <ItemsControl ItemsSource="{Binding PpeOptions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="16"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:PpeToggleViewModel">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="panel" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Avaliação de risco ocupacional (NR-01)" Classes="section"/>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Severidade — magnitude da consequência mais grave possível" Classes="label"/>
                      <ComboBox ItemsSource="{Binding SeverityOptions}"
                                SelectedItem="{Binding SelectedSeverity}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Probabilidade — chance da lesão, dada a exposição e a eficácia das medidas" Classes="label"/>
                      <ComboBox ItemsSource="{Binding ProbabilityOptions}"
                                SelectedItem="{Binding SelectedProbability}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding RiskLevelDisplay, StringFormat='Nível de risco: {0}'}" FontWeight="Bold"/>
                      <TextBlock Text="{Binding RiskDecisionHint}" Classes="hint"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="panel" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Textos para o participante" Classes="section"/>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Dica (hint)" Classes="label"/>
                      <TextBox Text="{Binding HintText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Conselho de omissão (modo Avaliação)" Classes="label"/>
                      <TextBox Text="{Binding OmissionAdvice}" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Conselho em caso de falha" Classes="label"/>
                      <TextBox Text="{Binding FailureAdvice}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Conselho de EPI" Classes="label"/>
                      <TextBox Text="{Binding PpeAdvice}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Dica adicional (sucesso)" Classes="label"/>
                      <TextBox Text="{Binding SuccessAdvice}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                      <CheckBox Content="Narrar com voz" IsChecked="{Binding SuccessAdviceNarrated}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="panel" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Distratores (EPIs errados)" Classes="section"/>
                    <TextBlock IsVisible="{Binding !IsEquipTask}" Classes="hint"
                               Text="Só tarefas de equipar EPI (sem ação e com EPI requerido) oferecem distratores."/>
                    <StackPanel IsVisible="{Binding IsEquipTask}" Spacing="6">
                      <TextBlock Classes="hint"
                                 Text="Escolha itens do catálogo do cenário. Para cadastrar ou editar um distrator, use a aba Distratores."/>
                      <ItemsControl ItemsSource="{Binding LinkedDistractors}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:DistractorViewModel">
                            <DockPanel Margin="0,0,0,4">
                              <Button DockPanel.Dock="Right" Content="Remover" Click="OnUnlinkDistractor"/>
                              <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Adicionar" Click="OnLinkDistractor" Margin="6,0,0,0"
                                IsEnabled="{Binding DistractorToLink, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <ComboBox ItemsSource="{Binding DistractorCatalog}" SelectedItem="{Binding DistractorToLink}"
                                  PlaceholderText="Escolha um distrator do catálogo…" HorizontalAlignment="Stretch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:DistractorViewModel">
                              <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="panel" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Popup de reporte" Classes="section"/>
                    <CheckBox Content="Esta tarefa abre um popup de reporte com alternativas"
                              IsChecked="{Binding HasReportPopup}"/>
                    <StackPanel IsVisible="{Binding HasReportPopup}" Spacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Título do popup" Classes="label"/>
                        <TextBox Text="{Binding ReportPopupTitle}"/>
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="Pergunta (corpo do popup)" Classes="label"/>
                        <TextBox Text="{Binding ReportPopupBody}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                 Watermark="ex.: Como esta irregularidade deve ser classificada?"/>
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Text="Alternativas (botões do popup) — de 2 a 4; marque a correta" Classes="label"/>
                        <ItemsControl ItemsSource="{Binding ReportOptions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ReportOptionViewModel">
                              <Grid ColumnDefinitions="Auto,*,8,140,8,Auto" Margin="0,0,0,4">
                                <RadioButton Grid.Column="0" Content="Correta" IsChecked="{Binding Correct}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Label}" Watermark="texto do botão"/>
                                <TextBox Grid.Column="3" Text="{Binding Id}" Watermark="id (automático)"
                                         ToolTip.Tip="Chave de análise. Deixe vazio para gerar a partir do texto; não mude depois de coletar dados."/>
                                <Button Grid.Column="5" Content="Remover" Click="OnRemoveReportOption"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Alternativa" Click="OnAddReportOption" HorizontalAlignment="Left"
                                IsEnabled="{Binding CanAddReportOption}"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>

          </ContentControl.DataTemplates>
        </ContentControl>
      </ScrollViewer>
    </Grid>
      </TabItem>

      <TabItem Header="Distratores">
        <Grid ColumnDefinitions="2*,Auto,3*">
          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasScenario}"
                       Text="Nenhum cenário aberto.&#x0a;Use Novo ou Abrir…"
                       Foreground="{DynamicResource SpTextDim}" Margin="4,12"/>

            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasScenario}" Spacing="6" Margin="0,0,8,8">
              <TextBlock Classes="hint"
                         Text="Itens errados que a cena oferece. Cadastre aqui e vincule cada um a uma tarefa de equipar EPI, na aba Cenário."/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="+ Distrator" Click="OnAddDistractor"/>
                <Button Content="Remover" Click="OnRemoveDistractor"
                        IsEnabled="{Binding Editor.SelectedDistractor, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              </StackPanel>
            </StackPanel>

            <Border Classes="panel" Margin="0,0,8,0" IsVisible="{Binding HasScenario}">
              <ListBox ItemsSource="{Binding Editor.Distractors}"
                       SelectedItem="{Binding Editor.SelectedDistractor, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:DistractorViewModel">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding UsedBy, StringFormat='Usado em: {0}'}" FontSize="11"
                                 Foreground="{DynamicResource SpTextDim}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </DockPanel>

          <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"/>

          <ScrollViewer Grid.Column="2" Margin="8,0,0,0">
            <ContentControl Content="{Binding Editor.SelectedDistractor}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:DistractorViewModel">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Distrator" Classes="heading"/>
                    <Grid ColumnDefinitions="*,8,2*">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Id" Classes="label"/>
                        <TextBox Text="{Binding Id}" Watermark="ex.: flip_flops"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Nome" Classes="label"/>
                        <TextBox Text="{Binding Name}" Watermark="ex.: Chinelo"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Classes="hint"
                               Text="O id deve ser único e igual ao 'distractorId' do prefab na cena; mudá-lo desliga o item da cena."/>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Por que está errado" Classes="label"/>
                      <TextBox Text="{Binding RejectionAdvice}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                               Watermark="Aparece quando o participante tenta equipar este item."/>
                    </StackPanel>
                    <TextBlock Text="{Binding UsedBy, StringFormat='Usado em: {0}'}" Classes="hint"/>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="EPIs">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                     Text="EPIs que este build implementa, conforme o catálogo de capacidades, e o nome que o participante vê para cada um. Para exigir um EPI, marque-o na tarefa, na aba Cenário."/>

          <!-- The notice sits at the bottom on purpose: the list is the content, and the
               notice explains why none of it is editable here. -->
          <Border DockPanel.Dock="Bottom" Classes="panel" Padding="12" Margin="0,8,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="Alterações só por um desenvolvedor" Classes="section"/>
              <TextBlock Classes="hint"
                         Text="Estas informações estão definidas no código do aplicativo e não podem ser alteradas aqui. Mudar o nome de um EPI, ou criar um EPI novo, exige um desenvolvedor: um EPI novo precisa do modelo 3D, do encaixe no corpo do participante e do registro no código e no catálogo de capacidades."/>
            </StackPanel>
          </Border>

          <Border Classes="panel" Padding="12">
            <ScrollViewer>
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="160,220,*">
                  <TextBlock Grid.Column="0" Text="Tipo (id)" Classes="label"/>
                  <TextBlock Grid.Column="1" Text="Nome exibido" Classes="label"/>
                  <TextBlock Grid.Column="2" Text="Exigido pelas tarefas" Classes="label"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding PpeList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PpeInfoViewModel">
                      <Grid ColumnDefinitions="160,220,*" Margin="0,4">
                        <TextBlock Grid.Column="0" Text="{Binding TypeId}" FontFamily="Cascadia Mono, Consolas, monospace"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding RequiredBy}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SpTextDim}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock IsVisible="{Binding !HasPpeList}" Classes="hint"
                           Text="Nenhum catálogo de capacidades carregado. Use Catálogo… para abrir o capability_catalog.json."/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Dicas finais">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasScenario}"
                     Text="Nenhum cenário aberto.&#x0a;Use Novo ou Abrir…"
                     Foreground="{DynamicResource SpTextDim}" Margin="4,12"/>

          <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasScenario}" Spacing="6" Margin="0,0,0,8">
            <TextBlock Classes="hint"
                       Text="A tela final mostra uma dica sorteada desta lista."/>
            <Button Content="+ Dica" Click="OnAddFinishTip" HorizontalAlignment="Left"/>
          </StackPanel>

          <ScrollViewer IsVisible="{Binding HasScenario}">
            <ItemsControl ItemsSource="{Binding Editor.FinishTips}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:FinishTipViewModel">
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Remover" Click="OnRemoveFinishTip"
                            VerticalAlignment="Top" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Ações">
        <Grid ColumnDefinitions="2*,Auto,3*">
          <DockPanel Grid.Column="0">
            <!-- Wraps: these five buttons are wider than the 2* column, and a StackPanel
                 would spill them over the detail pane instead of breaking the line. -->
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal"
                       ItemSpacing="6" LineSpacing="6" Margin="0,0,8,8">
              <Button Content="Novo catálogo" Click="OnNewActionCatalog"/>
              <Button Content="+ Ação" Click="OnAddAction"/>
              <Button Content="Remover" Click="OnRemoveAction" IsEnabled="{Binding HasActionCatalog}"/>
              <Button Content="Validar" Click="OnValidateActionCatalog" IsEnabled="{Binding HasActionCatalog}"/>
              <Button Content="Salvar ações…" Click="OnSaveActionCatalog" IsEnabled="{Binding HasActionCatalog}"/>
            </WrapPanel>

            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasActionCatalog}"
                       Text="Nenhum catálogo de ações aberto.&#x0a;Use Ações… ou Novo catálogo."
                       Foreground="{DynamicResource SpTextDim}" Margin="4,12"/>

            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasActionCatalog}" Spacing="2" Margin="0,0,8,8">
              <TextBlock Text="Versão" Classes="label"/>
              <TextBox Text="{Binding ActionEditor.Version}"/>
            </StackPanel>

            <Border Classes="panel" Margin="0,0,8,0"
                    IsVisible="{Binding HasActionCatalog}">
              <ListBox ItemsSource="{Binding ActionEditor.Actions}"
                       SelectedItem="{Binding ActionEditor.SelectedAction, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ActionViewModel">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding TreeLabel}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource SpTextDim}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </DockPanel>

          <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"/>

          <ScrollViewer Grid.Column="2" Margin="8,0,0,0">
            <ContentControl Content="{Binding ActionEditor.SelectedAction}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ActionViewModel">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Ação" Classes="heading"/>
                    <StackPanel Spacing="2">
                      <TextBlock Text="actionId" Classes="label"/>
                      <TextBox Text="{Binding ActionId}" Watermark="ex.: inspect_ladder"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Nome exibido" Classes="label"/>
                      <TextBox Text="{Binding DisplayName}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Descrição" Classes="label"/>
                      <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*">
                      <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                        <TextBlock Text="Categoria" Classes="label"/>
                        <TextBox Text="{Binding Category}" Watermark="TaskStep"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Telemetry name" Classes="label"/>
                        <TextBox Text="{Binding TelemetryName}" Watermark="usa actionId se vazio"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Tags (separadas por vírgula)" Classes="label"/>
                      <TextBox Text="{Binding TagsCsv}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Referências normativas (separadas por vírgula)" Classes="label"/>
                      <TextBox Text="{Binding RegulatoryRefsCsv}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <CheckBox Content="Crítica para segurança" IsChecked="{Binding IsSafetyCritical}"/>
                      <CheckBox Content="Ocultar na UI" IsChecked="{Binding IsHiddenInUI}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,*">
                      <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                        <TextBlock Text="Cooldown (s)" Classes="label"/>
                        <TextBox Text="{Binding CooldownSeconds}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,6,0">
                        <TextBlock Text="Duração esperada (s)" Classes="label"/>
                        <TextBox Text="{Binding ExpectedDurationSeconds}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2" Margin="0,0,6,0">
                        <TextBlock Text="Pontuação base" Classes="label"/>
                        <TextBox Text="{Binding BaseScore}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock Text="Severidade" Classes="label"/>
                        <TextBox Text="{Binding Severity}"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
