<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafetyProto.AuthoringApp.Gui.App">
  <!-- The variant is not pinned here: App.OnFrameworkInitializationCompleted sets it from
       the persisted preference (ThemePreference), defaulting to Light. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SafetyProto.AuthoringApp.Gui/Themes/Tokens.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SafetyProto.AuthoringApp.Gui/Themes/Controls.axaml"/>
  </Application.Styles>
</Application>
