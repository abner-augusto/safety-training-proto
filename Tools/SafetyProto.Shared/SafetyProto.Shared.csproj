<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- Suppress IDE1006 (naming rule) globally — the ISafetyTask / ITaskGroup interfaces
         intentionally use lowercase property names to match existing Unity field names.
         This allows explicit interface implementation in Part 2 without renaming the SO
         fields, which would break every Inspector reference in the project. -->
    <NoWarn>IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interfaces (Part 1) -->
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Interfaces\IEventBus.cs"       Link="Core\Interfaces\IEventBus.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Interfaces\IScoreService.cs"   Link="Core\Interfaces\IScoreService.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Interfaces\ISafetyTask.cs"     Link="Core\Interfaces\ISafetyTask.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Interfaces\ITaskGroup.cs"      Link="Core\Interfaces\ITaskGroup.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Interfaces\ITimerSource.cs"    Link="Core\Interfaces\ITimerSource.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Interfaces\IAsyncScheduler.cs" Link="Core\Interfaces\IAsyncScheduler.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Interfaces\ISessionResettable.cs" Link="Core\Interfaces\ISessionResettable.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Logging\IHarnessLogger.cs"     Link="Core\Logging\IHarnessLogger.cs" />

    <!-- Enums (Part 1) -->
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\PPEType.cs"                    Link="Core\PPEType.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\ViolationCodes.cs"             Link="Core\ViolationCodes.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\TaskState.cs"                  Link="Core\TaskState.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\RiskLevel.cs"                  Link="Core\RiskLevel.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\RiskAssessment.cs"             Link="Core\RiskAssessment.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\SessionMode.cs"                Link="Core\SessionMode.cs" />

    <!-- Payloads (Part 3) -->
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\EventPayloads.cs"              Link="Core\EventPayloads.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Events\ActionAttemptedEvent.cs" Link="Core\Events\ActionAttemptedEvent.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Events\ActionRefusedEventArgs.cs" Link="Core\Events\ActionRefusedEventArgs.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Events\PopupClosedEventArgs.cs" Link="Core\Events\PopupClosedEventArgs.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Events\PopupShownEventArgs.cs" Link="Core\Events\PopupShownEventArgs.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\RuntimeSafetyTask.cs" Link="Core\RuntimeSafetyTask.cs" />

    <!-- Part 4 additions -->
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Events\EventContext.cs"        Link="Core\Events\EventContext.cs" />
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Events\EventMetadata.cs"       Link="Core\Events\EventMetadata.cs" />

    <!-- Part 6 additions -->
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Core\Interfaces\IPPEComplianceChecker.cs" Link="Core\Interfaces\IPPEComplianceChecker.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Domain.Core.asmdef sets noEngineReferences=true, so everything under Domain/ is
         engine-free by construction and can be compiled wholesale. Core/ is mixed
         (ScriptableObjects, UnityEngine facades) and stays an explicit list above. -->
    <Compile Include="..\..\Assets\_SafetyProto\Scripts\Domain\**\*.cs"
             Link="Domain\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
